{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "scripts/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": [
    "vendor",
    "node_modules"
  ]
}
